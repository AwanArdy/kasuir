{
  "name": "kasir-backend",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "axios": "^1.16.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.30.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5",
    "sqlite3": "^5.1.7",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.7",
    "@types/sqlite3": "^3.1.11",
    "@types/uuid": "^9.0.8",
    "drizzle-kit": "^0.20.14",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "central:dev": "nodemon --exec tsx backend/central/index.ts",
    "central:seed": "tsx backend/central/seed.ts",
    "central:generate": "drizzle-kit generate:pg --config drizzle.config.central.ts",
    "central:push": "drizzle-kit push:pg --config drizzle.config.central.ts",
    "local:dev": "nodemon --exec tsx backend/local/index.ts",
    "local:push": "drizzle-kit push:sqlite --config drizzle.config.local.ts",
    "test:integration": "tsx tests/multi-outlet.test.ts"
  }
}
